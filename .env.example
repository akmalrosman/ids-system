APP_NAME=ATSC-IDS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (used on the server and with Docker).
# For a quick local try without PostgreSQL you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ids
DB_USERNAME=ids
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Integrated Debrief System (all used in config/ids.php) ----

# First admin account created by `php artisan db:seed` (production requires ADMIN_PASSWORD).
ADMIN_EMAIL=super@email.com
ADMIN_PASSWORD=

# How Laravel runs the Node.js FDR parser: cli (default) or http (npm run fdr:server)
FDR_PARSER_DRIVER=cli
# Full path if "node" is not on the PATH, e.g. C:\Program Files\nodejs\node.exe
NODE_BINARY=node
FDR_PARSER_URL=http://127.0.0.1:3100
# Timezone of the timestamps inside DJI logs
FDR_LOG_TZ_OFFSET=+08:00
FDR_MAX_SAMPLE_RATE=10

# Real encrypted DJI .txt logs (see fdr-parser/README.md). Leave empty until you have a DJI App Key.
DJI_LOG_PARSER_CMD=
DJI_API_KEY=

# Offline map tiles (npm run tiles:download)
MAP_TILE_URL=/tiles/{z}/{x}/{y}.jpg
MAP_MIN_ZOOM=5
MAP_MAX_ZOOM=16

# Docker only: host port for the web container
APP_PORT=8080
