# Production settings template. On the server:
#   cp .env.production.example .env
# then fill in every value marked CHANGE ME. See docs/DEPLOYMENT.md.

APP_NAME=ATSC-IDS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE ME: the exact address people type in the browser, including the port
# (e.g. http://10.0.0.5:8080 or https://ids.example.com). Every link, CSS and JS URL is built from it.
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Docker: DB_HOST is set to "db" by docker-compose.yml. Bare metal: 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ids
DB_USERNAME=ids
# CHANGE ME
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# First admin account created by `php artisan db:seed --force`
# CHANGE ME (both)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Node.js FDR parser
FDR_PARSER_DRIVER=cli
NODE_BINARY=node
FDR_PARSER_URL=http://127.0.0.1:3100
FDR_LOG_TZ_OFFSET=+08:00
FDR_MAX_SAMPLE_RATE=10

# DJI App Key (developer.dji.com, "Open API" app) to decrypt real DJI .txt flight records.
# Needs internet once per new file; the keys are then kept in storage/app/dji-keychains. Keep it secret.
DJI_API_KEY=

# Offline map tiles (public/tiles)
MAP_TILE_URL=/tiles/{z}/{x}/{y}.jpg
MAP_MIN_ZOOM=5
MAP_MAX_ZOOM=16
MAP_SOURCE_RESOLUTION_M=10

# Docker only: host port for the web container
APP_PORT=8080
